# Terraform state files (contain sensitive data)
*.tfstate
*.tfstate.*
terraform.tfstate
terraform.tfstate.backup

# Terraform variables (may contain secrets like API tokens)
*.tfvars
*.tfvars.json

# Terraform cache and plugin directories
.terraform/
.terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# Generated SSH config (contains IPs)
ssh_config

# SSH keys (never commit private keys)
*.pem
id_rsa
id_rsa.pub

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive plan output
*.tfplan
